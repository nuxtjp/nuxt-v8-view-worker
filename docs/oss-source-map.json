{
  "repository": "nuxtjp/nuxt-v8-view-worker",
  "purpose": "許可された単純な入力から、制限されたV8環境で表示断片を生成できます。 / Render declared scalar input into a limited view fragment using a verified Rust/V8 worker.",
  "responsibility_boundary": "Own the documented Nuxt/browser interface and its public contracts. Account authority, external effects, product state and production hosting remain explicit consumer responsibilities.",
  "packages": [
    {
      "manifest": "Cargo.toml",
      "package": "nuxt-v8-view-worker",
      "ecosystem": "rust",
      "description": "A fail-closed, process-isolated V8 view renderer for NuxtJP",
      "interfaces": {
        "lib": "src/lib.rs",
        "features": {
          "default": [
            "v8-engine"
          ],
          "v8-engine": [
            "dep:v8"
          ]
        },
        "bins": [
          {
            "name": "nuxt-v8-view-worker",
            "path": "src/bin/nuxt-v8-view-worker.rs",
            "required-features": [
              "v8-engine"
            ]
          }
        ],
        "public_modules": [
          "contract",
          "digest",
          "host",
          "input",
          "render"
        ],
        "public_reexports": [
          "contract::{HostConfig, Limits, RenderRequest, RenderResponse, SCRIPT_ID, SCRIPT_SHA256}",
          "host::launch",
          "render::render"
        ],
        "implicit_bins": [
          "src/bin/nuxt-v8-view-host.rs",
          "src/bin/nuxt-v8-view-worker.rs"
        ]
      },
      "declared_commands": {}
    }
  ],
  "schema_definitions": [
    "schemas/host-config.schema.json",
    "schemas/request.schema.json",
    "schemas/response.schema.json"
  ],
  "test_sources": [
    "src/bin/nuxt-v8-view-host.rs",
    "src/bin/nuxt-v8-view-worker.rs",
    "src/host_tests.rs",
    "src/input.rs",
    "src/process.rs",
    "src/render.rs",
    "tests/host_config_file_boundary.rs",
    "tests/worker_contract.rs"
  ],
  "example_sources": [
    "examples/host-config.example.json",
    "examples/request.json"
  ],
